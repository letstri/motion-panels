{
  "name": "glidepanels",
  "displayName": "Glidepanels",
  "version": "0.1.0",
  "private": false,
  "description": "Resizable panels that glide. Framework-agnostic core, animated with Motion, unstyled, no layout library.",
  "keywords": [
    "animation",
    "drag",
    "layout",
    "motion",
    "panels",
    "react",
    "resizable",
    "resizable-panels",
    "split-pane",
    "splitter",
    "vue"
  ],
  "homepage": "https://github.com/letstri/glidepanels",
  "bugs": {
    "url": "https://github.com/letstri/glidepanels/issues"
  },
  "license": "MIT",
  "author": "Valerii Strilets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letstri/glidepanels.git",
    "directory": "glidepanels"
  },
  "funding": "https://github.com/sponsors/letstri",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --build",
    "prepublishOnly": "run-s check-types test build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "happy-dom": "^20.14.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
